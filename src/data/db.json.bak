          "content": "import { Smartphone, Apple, Play } from 'lucide-react';\nimport { motion } from 'motion/react';\n\nexport default function AppDownload() {\n  return (\n    <section className=\"py-24 bg-surface border-b border-outline\">\n      <div className=\"max-w-7xl mx-auto px-8 md:px-16\">\n        <motion.div \n          initial={{ opacity: 0 }}\n          whileInView={{ opacity: 1 }}\n          viewport={{ once: true }}\n          className=\"bg-black border border-white/10 overflow-hidden flex flex-col md:flex-row items-center gap-16 p-12 md:p-24 relative\"\n        >\n          <div className=\"md:w-1/2\">\n            <div className=\"text-[10px] font-bold text-primary mb-8 tracking-[0.4em] uppercase\">003 / Mobile</div>\n            <h2 className=\"text-6xl md:text-8xl font-black mb-8 tracking-tighter uppercase leading-[0.85]\">\n              System<br/>\n              <span className=\"text-stroke\">Mobile</span>\n            </h2>\n            <p className=\"text-sm opacity-50 mb-12 max-w-sm leading-relaxed font-medium\">\n              Precision in your pocket. Track every byte of data from kitchen to doorstep with our generative mobile interface.\n            </p>\n\n            <div className=\"flex flex-col sm:flex-row items-center gap-12\">\n              <div className=\"border border-white/10 p-4 bg-white/[0.02] flex-shrink-0\">\n                <img \n                  src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBcCsVi44dxTn5rHQYWM3fIPHRg6bV02A-O1EHClnbxD1xmj-4xXc8XiyDJmFT9RbhiKMLuuVwmH5455GpVcIC6y2DONzAmjPTJeseVYXM3FiX6fqZ45s2mPTDi1JV6EuKFjUMxags1NNW53TI2OD2gPPbpk-ZImse3TsLq_lHf1tsDEs0MGow2lalNyPCpEK0YRJ_GO9sVTzTuQJ7XCPBWkGbRAmg2vXfQRO0t0SLOO0h0eh5cnNOF\" \n                  alt=\"QR Code\" \n                  className=\"w-24 h-24 filter invert\"\n                />\n              </div>\n              \n              <div className=\"text-center sm:text-left\">\n                <p className=\"text-[10px] font-bold mb-6 uppercase tracking-widest opacity-40\">Access Nodes</p>\n                <div className=\"flex flex-wrap gap-4\">\n                  <motion.button \n                    whileHover={{ backgroundColor: '#D1FA01', color: '#000000' }}\n                    className=\"border border-white/20 px-8 py-4 flex items-center gap-3 transition-colors group\"\n                  >\n                    <Smartphone className=\"w-4 h-4\" />\n                    <span className=\"text-[10px] font-bold uppercase tracking-widest\">iOS.Studio</span>\n                  </motion.button>\n                  <motion.button \n                    whileHover={{ backgroundColor: '#D1FA01', color: '#000000' }}\n                    className=\"border border-white/20 px-8 py-4 flex items-center gap-3 transition-colors group\"\n                  >\n                    <Play className=\"w-4 h-4 fill-current\" />\n                    <span className=\"text-[10px] font-bold uppercase tracking-widest\">Play.Studio</span>\n                  </motion.button>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"md:w-1/2 flex justify-center\">\n            <div className=\"relative w-72 h-[580px] bg-neutral-900 border border-white/10 p-4 shadow-2xl\">\n              {/* Phone Content */}\n              <div className=\"bg-black w-full h-full border border-white/5 overflow-hidden relative\">\n                <div className=\"p-8\">\n                  <div className=\"flex justify-between items-center mb-12\">\n                    <div className=\"w-6 h-6 border border-white/20 flex items-center justify-center\">\n                      <div className=\"w-3 h-[1px] bg-white\" />\n                    </div>\n                    <div className=\"w-8 h-8 rounded-full border border-primary/40 bg-primary/5\" />\n                  </div>\n\n                  <div className=\"border border-white/10 overflow-hidden mb-12 bg-neutral-900/50\">\n                    <img \n                      src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBxO-9gaNr5eMoGRi9uP9Nx8K3FwJJ1GvZd6bNJYihncL-71pt9QByuyymIeN8hHOvxYnrAvGMl4n5F0ameCNppzPKYcGdkvl2lx3tpzlVvwVgbi7Wc-bpDXrASHFNQ5yP6EQBcU7JGBHbkcEyYNkO96tttO8zXPbIqyAd-UyTIhRhyfqIFqdhV0TsrT4KQirzJGdf1TQmMmzoRnsnCLhPBeAWgv6R7z58nyitO_U5g0GIjgQLJV8Wq\" \n                      alt=\"Salad Bowl\" \n                      className=\"w-full aspect-[4/3] object-cover opacity-60 filter grayscale hover:grayscale-0 transition-all\"\n                    />\n                  </div>\n\n                  <div className=\"space-y-6\">\n                    <div className=\"h-[1px] bg-white/10 w-full\" />\n                    <div className=\"h-[1px] bg-white/10 w-2/3\" />\n                    <div className=\"h-[1px] bg-white/10 w-1/2\" />\n                    <div className=\"pt-8\">\n                      <div className=\"h-12 border border-primary bg-primary/10 flex items-center justify-center text-primary font-bold text-[10px] uppercase tracking-widest shadow-[0_0_15px_rgba(209,250,1,0.1)]\">\n                        Track Live Node\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </motion.div>\n      </div>\n    </section>\n  );\n}\n"
        }
